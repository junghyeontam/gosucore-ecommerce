# ============================================================
# GOSUCORE - CẤU HÌNH MÔI TRƯỜNG
# ============================================================
# QUAN TRỌNG: Đừng commit file này lên GitHub!
# Thêm ".env" vào file .gitignore của bạn.
# ============================================================

# --- SERVER ---
PORT=3000
NODE_ENV=development

# --- SQL SERVER ---
# Thay các giá trị bên dưới bằng thông tin SQL Server của bạn
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=123456
DB_NAME=GosuCoreDB
# Nếu dùng SQL Server trên máy local (không có SSL): để là false
DB_ENCRYPT=false
DB_TRUST_CERT=true

# --- JWT ---
# Đổi thành chuỗi bí mật ngẫu nhiên của bạn (ít nhất 32 ký tự)
JWT_SECRET=gosucore_super_secret_key_2024_change_this
JWT_EXPIRES_IN=7d

# --- BCRYPT ---
BCRYPT_ROUNDS=10
